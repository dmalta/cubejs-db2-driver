# Integration-test targets. Copy to .env (gitignored) and fill in.
# Tests run only with DB2_REAL_TEST=true (npm run test:integration).
DB2_IT_TARGETS=ZOS,LUW

# A DB2 for z/OS target
DB2_IT_ZOS_PLATFORM=zos
DB2_IT_ZOS_HOST=<host>
DB2_IT_ZOS_PORT=<port>
DB2_IT_ZOS_NAME=<location>
DB2_IT_ZOS_USER=<user>
DB2_IT_ZOS_PASS=<password>
DB2_IT_ZOS_SSL_SERVER_CERTIFICATE=</path/to/root_ca.pem>
# Optional: write-path (pre-aggregation) tests
DB2_IT_ZOS_WRITE_SCHEMA=<schema you can create tables in>
DB2_IT_ZOS_PREAGG_DATABASE=<database>
DB2_IT_ZOS_PREAGG_TABLESPACE=<tablespace>
# Optional: a real table + timestamp column for Cube-shaped query tests
DB2_IT_ZOS_SOURCE_TABLE=<schema.table>
DB2_IT_ZOS_SOURCE_TIME_COLUMN=<column>

# A DB2 LUW target
DB2_IT_LUW_PLATFORM=luw
DB2_IT_LUW_HOST=<host>
DB2_IT_LUW_PORT=<port>
DB2_IT_LUW_NAME=<database>
DB2_IT_LUW_USER=<user>
DB2_IT_LUW_PASS=<password>
